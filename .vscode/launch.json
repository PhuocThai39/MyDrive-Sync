{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "LoadTestMain",
      "request": "launch",
      "mainClass": "vn.edu.pbl4sync.tools.LoadTestMain",
      "projectName": "pbl4-company-sync"
    },
    {
      "type": "java",
      "name": "Run PBL4 Server",
      "request": "launch",
      "mainClass": "vn.edu.pbl4sync.server.ServerMain",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Run PBL4 Agent",
      "request": "launch",
      "mainClass": "vn.edu.pbl4sync.client.ClientMain",
      "cwd": "${workspaceFolder}"
    }
  ]
}
